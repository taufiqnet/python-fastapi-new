# ProERP SaaS - Staging / Test Environment Configuration
APP_ENV=staging
DEBUG=True

# Staging Database Configuration (Separated from Production)
DB_HOST=db
DB_PORT=5432
DB_NAME=fastapi_staging
DB_USER=postgres
DB_PASSWORD=staging_secure_password_replace_me
DATABASE_URL=postgresql://postgres:staging_secure_password_replace_me@db:5432/fastapi_staging

# Staging Server Ports
APP_HOST=0.0.0.0
APP_PORT=8000

# Security (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=staging_only_secret_key_change_in_real_server_xyz123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Authorization Mode
AUTH_STRATEGY=rbac
SUBSCRIPTION_REQUIRED=False

# AI Assistant
AI_ASSISTANT_ENABLED=False
OPENROUTER_API_KEY=mock-key-for-staging
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODELS=openrouter/free

# CORS for Decoupled Staging Frontend
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://staging.proerp.com
